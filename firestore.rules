rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // collectionPoints: public read, operator/admin write only
    match /collectionPoints/{cpId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        request.auth.token.role == 'operator' || 
        request.auth.token.role == 'admin' ||
        resource.data.operatorId == request.auth.uid
      );
    }

    // recyclingActivities: read by owner or operator, NO direct client writes (only Cloud Functions write)
    match /recyclingActivities/{activityId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.role == 'operator' ||
        request.auth.token.role == 'admin'
      );
      // Deny client writes: only Cloud Functions with admin SDK can mint points, verify activities, and write activities
      allow write: if false;
    }

    // users: read by owner, limited profile updates
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Disallow client manipulation of verified points, carbonCredits, totalRecycledKg
      allow update: if isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalRecycledKg', 'verifiedDropoffs', 'carbonCredits', 'ecoPoints']);
      allow create: if isOwner(userId);
    }
  }
}
